# ============================================================
# .gitignore — Limo Directory Scraper
# ============================================================

# ── Environment & Secrets (NEVER commit these) ────────────────
.env
.env.local
.env.production
.env.staging
*.env
config/proxies.txt

# ── Python ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python

# Virtual environments
venv/
.venv/
env/
ENV/
.env/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
.eggs/
wheels/

# ── Testing & Coverage ────────────────────────────────────────
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.tox/
nosetests.xml
test-results/

# ── IDE & Editors ─────────────────────────────────────────────
.vscode/settings.json
.vscode/launch.json
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ── Playwright ────────────────────────────────────────────────
# Browser binaries are installed at runtime (playwright install chromium)
playwright/.local-browsers/
test-results/
playwright-report/

# ── Scraped data & logs (too large/sensitive for git) ─────────
data/
*.csv
*.json
scrape_logs/
logs/
*.log

# ── Downloaded images (stored in Supabase Storage instead) ────
images/
downloads/
*.jpg
*.jpeg
*.png
*.gif
*.webp

# ── Docker ────────────────────────────────────────────────────
# Keep docker-compose.yml and Dockerfile, ignore runtime artifacts
.docker/

# ── OS files ──────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Desktop.inisource venv/bin/activate  